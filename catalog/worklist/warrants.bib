% warrants.bib — the el-openglo worklist as a claim-DAG.
%
% THE GOVERNING INVARIANT: every claim here is UNDISCHARGED until its check
% passes, and the item is incomplete until it can be discharged.  Those are the
% same fact — a claim whose check exits non-zero is a claim the gate refuses to
% certify, so `open item` and `red check` are one state, computed fresh on every
% run.
%
% ⚑ THERE IS NO open/closed FIELD, AND THERE MUST NEVER BE ONE.  Openness is
% computed from exit codes; nothing records it, so nothing about it can go
% stale.  Recording open-ness is precisely the failure mode this design exists
% to dissolve — and this repo is a RECOVERY, where a stale status note is
% exactly what went wrong: RECOVERY-NOTES.md still calls the segment API "the
% main rebuild gap" after most of it had been recovered.
%
% `claim` is the COMMITMENT — one line.  The finding it came from lives in the
% plan and in COTYPE.md.  Do not grow these into paragraphs: the one-line limit
% is what forces a figure into a checkable [tag].
%
% `rests-on` is GROUNDING (a claim cannot be TRUE unless its premises are);
% prose order is separate.  Do not conflate the two.
%
% This file is SOURCE and is meant to be edited.  WORKLIST.md is the projection
% and must never be hand-edited — the gate refuses it.
%
% ⚑ ON NAMING: this document must never spell the retired mark, or the very
% file certifying its absence would be a counterexample to its own claim.  It is
% "the prior mark" throughout, and scripts/check_mark.py is its only speller.

% ── rename ───────────────────────────────────────────────────────────────────
@misc{MARK,
  section = {rename},
  claim   = {no file in the tree carries the prior mark, outside the historical records that must quote it},
  check   = {tool:check_mark.py}
}

@misc{MARK-SEES,
  section = {rename},
  claim   = {the scrub's own scan is proven able to SEE the mark, so its all-clear is a measurement rather than a blind spot},
  rests-on = {MARK},
  check   = {tool:check_mark.py --selftest}
}

% ── recovery ─────────────────────────────────────────────────────────────────
% ⚑ The archive shipped 8 files marked ** PARTIAL ** — replayed to an
% INTERMEDIATE state because a later edit's anchor text was not found.  They all
% BYTE-COMPILE, which is exactly why compiling is too weak a witness to certify
% them: the recovery's own honesty is that they may be syntactically fine and
% behaviourally wrong.  Compilation is claimed here as what it is, and no more.
@misc{COMPILES,
  section = {recovery},
  claim   = {every recovered generator byte-compiles},
  check   = {tool:check_compiles.py}
}

@misc{PARTIAL,
  section = {recovery},
  claim   = {every file the archive marked partial is still recorded as partial, so a syntactically-clean file is never mistaken for a verified one},
  rests-on = {COMPILES},
  check   = {tool:check_partial.py}
}

@misc{DEPS,
  section = {recovery},
  claim   = {every third-party import in the tree is accounted for in one manifest, declared or recorded as deliberately absent},
  check   = {tool:check_deps.py}
}

% ── pipeline ─────────────────────────────────────────────────────────────────
% ⚑ THE ONE REAL RECOVERY GAP.  Consumers import ST.SEG22 / ST.GEOM22; the
% recovered segment_topology.py defines neither.  Everything else the recovery
% notes called missing (the FORMATS lattice, project(), the glyph tables) was
% verified PRESENT — that note is stale, which is the standing argument for
% computing status instead of recording it.
@misc{ST22,
  section = {pipeline},
  claim   = {segment_topology exports the 22-segment geometry its consumers import},
  check   = {tool:check_st_api.py}
}

@misc{ST-ADD,
  section = {pipeline},
  claim   = {the endpoint and display-geometry helpers shipped as a separate additions file are merged into the module that owns them},
  check   = {stsym:endpoints}
}

@misc{CONSUMERS,
  section = {pipeline},
  claim   = {the matcher and the showcase renderer import cleanly against that geometry},
  rests-on = {ST22, ST-ADD},
  check   = {tool:check_consumers.py}
}

% ⚑ THE CONSTRAINT EDGES HAD NO SINGLE AUTHORITY, AND THREE DEFECTS LIVED IN THE
% GAP: cvd_gate.audit_variant — the only consumer of ENFORCED/SURFACED — had NO
% CALLER, so eight separation pairs were declared and never gated; reference_floors()
% returns two identical scalars while _worst_normalized reads only one, so the
% enforced/surfaced distinction its docstring defends does not exist in the
% arithmetic; and _candidates prunes on a raw dE the module's own doctrine forbids.
% Three names for one fact: the table, the gate and the objective could disagree
% with nothing able to notice.
@misc{GRAPH,
  section = {pipeline},
  claim   = {the palette's constraint edges are named in one authority that the gate, the solver and the checks all read, so no two of them can disagree about which pairs are constrained},
  check   = {tool:check_palette_graph.py}
}

% ⚑ WHAT A PER-EDGE CHECK CANNOT SEE.  On a cycle, pairwise-satisfied constraints
% need not GLUE — every individual check passes and the composite is still wrong.
% That is the shape of both palette bugs found by looking rather than by checking
% (phosphor == accent; sel_act at 1.00:1), and b1 counts how many such failures the
% graph can hide.  Measured, not assumed: b1 = 24.
%
% ⚑ THIS CHECK'S OWN FIRST RUN IS THE ARGUMENT FOR THE SELFTEST.  It reported 26,
% because spanning_tree grows ONE tree from nodes[0] and the selection tokens form a
% SECOND component whose every edge then reads as a cycle.  Its docstring had already
% named the trap — "rather than counting E-V+C and hoping the graph is connected" —
% while the code hoped exactly that.
@misc{GRAPH-SEES,
  section = {pipeline},
  claim   = {the cycle-rank measurement is proven able to distinguish a cyclic graph from a tree and to refuse an empty population, so its number is a measurement rather than an artefact of the walk},
  rests-on = {GRAPH},
  check   = {tool:check_palette_graph.py --selftest}
}

% ⚑ DECLARED IS NOT GATED, AND THE DIFFERENCE WAS INVISIBLE.  cvd_gate.audit_variant
% is the only consumer of the ENFORCED/SURFACED pair lists and NOTHING CALLED IT —
% no script, no __main__, no other module.  Eight pairs read as covered while no run
% ever evaluated them, which is worse than not declaring them at all.  Measured on
% the first run: all 24 enforced pairs (6 variants x 4) clear the floor — the pairs
% were fine, and nothing in the tree knew it.
@misc{SEPARATION,
  section = {pipeline},
  claim   = {every separation pair the authority declares enforced is evaluated against the CVD floor on every variant, rather than merely being listed},
  rests-on = {GRAPH},
  check   = {tool:check_separation.py}
}

% ⚑ AN ALL-CLEAR AND A NEVER-RUN ARE THE SAME SILENCE.  That equivalence is exactly
% how the uncalled gate went unnoticed, so this witness feeds the walker a variant
% engineered to fail and asserts it says so.
@misc{SEPARATION-SEES,
  section = {pipeline},
  claim   = {the separation walk is proven able to SEE a violation, so its all-clear differs from its never-having-run},
  rests-on = {SEPARATION},
  check   = {tool:check_separation.py --selftest}
}

% ⚑ A CLOSURE OUTLIVED THE CAPABILITY IT CERTIFIED.  COTYPE.md's ⊕DOT-WIRE closure
% states that make_clock emits the whole display_types registry via
% `as_qml_js()` — "single source, nothing retyped".  Measured: as_qml_js had ZERO
% definitions and ZERO callers, and litPrimitives was absent from every consumer.
% The machinery was lost in the recovery and the prose asserting it survived —
% the same stale-status shape as RECOVERY-NOTES.md's "main rebuild gap", which is
% the standing argument for computing status rather than recording it.
%
% ⚑ AND IT IS A SUBSET, NOT THE WHOLE.  Emitting everything shipped five segment
% formats (48 glyphs each) into a DOT-MATRIX widget that reads none of them.
% "Single source" means a surface never SPELLS a table, not that it carries every
% table; registry_for() restricts to the displays a surface instantiates.
@misc{REGISTRY,
  section = {pipeline},
  claim   = {the display registry a surface receives is the emission of the Python one, restricted to the displays it instantiates, rather than a table retyped into QML},
  check   = {tool:check_display_registry.py}
}

@misc{REGISTRY-SEES,
  section = {pipeline},
  claim   = {the registry comparison is proven able to see a dropped table, a mangled one, a subset that carries the wrong displays, and a registry that disagrees with the substrate},
  rests-on = {REGISTRY},
  check   = {tool:check_display_registry.py --selftest}
}

% ⚑ A WRONG GLYPH ROUND-TRIPS PERFECTLY, WHICH IS WHY @REGISTRY WAS NOT ENOUGH.
% The 5x7 'A' shipped with its crossbar one row low and a flat apex. The emission
% check compares Python to Python so it survived untouched; the collision count
% stayed 0 because a malformed 'A' still differs from every other letter; and the
% source CONTRADICTED ITSELF — the comment above FONT5x7 gives 'A' as
% 0x7e,0x09,0x09,0x09,0x7e while the table held 0x11,0x11,0x11, with ⊕DOT's
% closure claiming the canonical glyphs were verified against references.
% Rendering the marquee and LOOKING is what caught it, the same way plymouth's
% clipped digits were caught.
@misc{FONT,
  section = {emitters},
  claim   = {every glyph in the matrix font agrees with the font it belongs to about where that font's shared features sit, so a malformed letter is caught by a check rather than only by a picture},
  rests-on = {REGISTRY},
  check   = {tool:check_display_registry.py}
}

% ⚑ THE SAMPLE MUST BE ABLE TO SHOW THE DEFECT.  After fixing 'A' the picture
% re-rendered byte-identical, because the sample read "EL OPENGLO 13:37" — no 'A'
% in it. Coverage of the SURFACE is not coverage of the FONT, and the difference
% is invisible while the sample happens to contain the broken glyph.
@misc{FONTSEEN,
  section = {emitters},
  claim   = {the marquee sample renders every glyph the font declares, so the picture can show a malformed one},
  rests-on = {SAMPLES, FONT},
  check   = {concept:marquee-covers-font}
}

% ⚑ A SCAN CANNOT BE SHOWN WRONG, WHICH IS THE DEFECT — NOT ITS ERROR.
% derive_ghost walked 99 points along lit->ground and returned the best SAMPLE;
% nothing in that answer says whether the true optimum lies between two of them.
% The balance point is a closed form: with a, b the offset luminances of lit and
% ground, the two sides are a/y and y/b, they move oppositely, so max-min is where
% they MEET — y = sqrt(ab), the geometric mean, each side sqrt(span). cvd_gate's
% own docstring already asserted "the achievable optimum is ~sqrt(contrast)"; it
% is a THEOREM, and the scan was rediscovering it to two decimals on every call.
%
% The difference is of KIND, not magnitude. Measured: the solve improves the worse
% side on 4 of 6 variants and ties on 2, by ~0.01-0.04 — small numbers that are
% easy to misreport as a small win. They are not. One answer is the best of a
% sample; the other satisfies an identity that can be checked, perturbed and
% refuted, which is what this check does.
@misc{GHOST,
  section = {emitters},
  claim   = {the ghost is the solved balance point of its two sides rather than the best of a sampled grid, and its solve is never worse than the scan it replaces},
  rests-on = {PALETTE-CHAIN},
  check   = {tool:check_ghost_balance.py}
}

% ⚑ THE ALGEBRA IS CHECKED AGAINST ITS OWN DEFINITION, NOT AGAINST THE SCAN.
% Checking a solve against the thing it replaces only shows they agree — including
% where both are wrong. So the witness verifies that y = sqrt(ab) EQUALISES the two
% sides, and that perturbing y in EITHER direction lowers the worse one, which is
% what makes it a maximum rather than merely a fixed point.
@misc{GHOST-SEES,
  section = {emitters},
  claim   = {the balance condition is verified as an identity and shown to fail on a deliberately unbalanced ghost, and the ceiling solve is shown to stay strictly under its threshold rather than reaching it},
  rests-on = {GHOST},
  check   = {tool:check_ghost_balance.py --selftest}
}

% ⚑ ADMISSIBILITY IS VISIBLE TO A CHECKER; OPTIMALITY IS ONLY VISIBLE TO A SOLVE.
% Filed for summit's ask-cvd-graphviz-theme (by substrate), and measuring its
% premise first corrected it twice: substrate had ALREADY stopped transcribing
% hexes, and picking from Okabe-Ito cannot fail the floor — all 2520 assignments of
% 5 roles over the 7 members clear q >= 1.0, necessarily, because the floor IS that
% palette's own tightest pair. So a check asserting q >= 1.0 would be
% UNFALSIFIABLE here and Δ would grade it vacuous.
%
% What can fail is OPTIMALITY, and the roles are an ARGUMENT, never ours: ours are
% neg/neu/pos/link/visited, theirs read/write/pywrite/flow/roundtrip/returns, and a
% theme hardcoding ours would be a bag of hexes with extra steps.
%
% ⚑ AND THE HEADLINE NUMBER I FIRST REPORTED WAS AN ARTIFACT OF MY OWN GUESSES.
% I read substrate's source and inferred two things: that `roundtrip` deliberately
% shared `flow`'s hue (its comment says weight carries the distinction) and that
% `returns` was not a palette role. Both wrong — the comment PREDATES the edge, and
% `returns` is real and wants a member. On those inferences the solve read q=2.758
% against a live 1.494 and I reported "54% of achievable". Corrected by the
% consumer, over its ACTUAL six roles, the optimum is q=1.494 — IDENTICAL to what
% it had already hand-assigned. Its four assigned colours were already optimal; the
% solve's contribution is placing the two it had not assigned (`roundtrip` off a
% shared hue, `returns` off the non-palette `neutral`) WITHOUT degrading the worst
% pair. A source read cannot recover intent, and the claim is what survived the
% correction rather than what the first measurement flattered.
@misc{ROLETHEME,
  section = {emitters},
  claim   = {the emitted role theme assigns palette members to a consumer's declared roles so that no other assignment over the same pool separates better, rather than merely clearing the floor},
  rests-on = {SEPARATION},
  check   = {tool:check_role_theme.py}
}

% ⚑ AND THE .dot MUST RENDER, NOT MERELY PARSE. The first emitter wrote
% `edgecolor=` — an attribute graphviz does not have — so the file parsed, `dot`
% exited 0, and every colour silently vanished into the default black. A valid
% artifact that is wrong is this repo's standing failure mode (a focus ring the
% colour of its own text; a foreground at 1.00:1; a malformed 5x7 glyph), so the
% witness renders the emitted file and asserts the colours SURVIVE INTO THE SVG.
@misc{ROLETHEME-SEES,
  section = {emitters},
  claim   = {the role-theme witness is proven to see a sub-optimal assignment and to see a colour that parses but does not reach the render, so its all-clear is a measurement},
  rests-on = {ROLETHEME},
  check   = {tool:check_role_theme.py --selftest}
}

% ⚑ THE CONSTRAINTS ARE STATED AS RELATIONS, NOT AS A PROCEDURE.  The palette's
% requirements were only ever expressed as the code that searched for them, so
% "what must hold" and "how we currently look for it" were one artifact — and a
% defect in the search read as a defect in the palette.  catalog/relations.md is
% the prose statement and palette_relations.py the machine-readable one, derived
% from the ONE edge authority rather than restated beside it.
%
% ⚑ AND THE HANDOFF IS THE WHOLE INTERFACE.  `netlist_input()` emits exactly the
% shape gcalc.solver consumes; nothing about elimination order, cost or verdicts
% appears, because those are the solver's and a relation presuming them would be a
% procedure wearing a relation's clothes.  Measured: the 42 relations reduce to 3
% symbolic terms between the 3 pinned terminals, 62 Q, verdict=halt.
@misc{RELATIONS,
  section = {pipeline},
  claim   = {every palette constraint is stated as a declarative relation with a named quantity and a kind, derived from the edge authority and accepted by the symbolic solver, rather than existing only as the search that looks for it},
  rests-on = {GRAPH},
  check   = {tool:check_relations.py}
}

% ⚑ A RELATION SET THAT HID ITS GAPS WOULD READ AS FINISHED.  Three are recorded
% and printed by --list: the discrete occupancy problem is unmeasured, the
% series-composition claim wants a witness, and the biases already in the code
% (the stride cap, every _lum_nudge) are expressible as no constraint.
@misc{RELATIONS-SEES,
  section = {pipeline},
  claim   = {the relation check is proven to see an invented role, a floor with no bound, a relation naming no quantity, a free node nothing reaches, and an empty set, and it records what the relations do NOT determine},
  rests-on = {RELATIONS},
  check   = {tool:check_relations.py --selftest}
}

% ⚑ THIS CLAIM IS RED AND MUST BE. It is not a check that fails; it is a DEFECT
% the check found, and the no-open/closed-field rule is what lets it sit here
% honestly rather than as a note somebody has to remember.
%
% SegmentChar.qml:73 draws the unlit core at `opacity: 0.45`. Every colour check
% measures `fg_in` against `view` DIRECTLY and none knows that number exists, so
% the ghost the gate certifies is not the ghost anyone sees: EL-Openglo is gated
% at 4.16:1 and renders at 1.79:1 against a floor of 3.00. All six variants are
% UNDER. The three Lit ones were already under before compositing.
%
% ⚑ AND THE SOLVE IS OPTIMISING THE BOUND THAT IS NOT IN DANGER. The ghost has a
% CEILING (must not read as text) and a FLOOR (must still read as shape); alpha
% makes the ceiling SAFER and the floor HARDER. Measured |Lc|: 29.8 declared, 7.7
% composited, against a limit of 30. derive_ghost_ceiling pushes to within 0.2 of
% a bound with a 22-point margin while nothing models the one being missed.
%
% ⚑ NO SINGLE-CONCERN CHECK COULD HAVE SEEN IT. Ghost subordination is carried by
% COLOUR and ALPHA (0.45) and WIDTH (0.65x) multiplying into one perceived
% quantity. A colour check sees no lengths and a geometry check sees no colours,
% which is why this lives at the JOIN — and why the fg_in~ghost_stroke edge that
% carries it is the first edge in the graph to cross between the two halves.
@misc{GHOSTCOMP,
  section = {emitters},
  claim   = {the ghost that renders clears the same floor the ghost that is gated does, so no contrast lives between the check and the screen},
  rests-on = {GHOST, RELATIONS},
  check   = {tool:check_ghost_composite.py}
}

@misc{GHOSTCOMP-SEES,
  section = {emitters},
  claim   = {the composite model is verified against arithmetic endpoints and shown to catch both a ghost below its floor and one over its readability ceiling, so the red above is a measurement rather than an artefact of the model},
  rests-on = {GHOSTCOMP},
  check   = {tool:check_ghost_composite.py --selftest}
}

% ⚑ A GRAPH READ AS A TABLE IS HOW A CYCLE STAYS INVISIBLE. 21 nodes over four
% families, with b1=24 counting the places pairwise satisfaction need not compose
% — none of which a per-edge listing can show. The render carries the graph's own
% structure (family, pinned-ness, cycle membership, elimination step) rather than
% laying out a bag of circles, and the elimination SEQUENCE shows the star->mesh
% fill-in that a static picture cannot.
%
% ⚑ AND THE ORDER IS A GAUGE WHILE THE COST IS NOT, which the frames make visible:
% min_degree spends 62 Q over 15 steps and the relations check's fixed order spends
% 68, same terminals and same three surviving terms. Eight of those steps cost ZERO
% — the geometry and selection tails are degree-1 — and the constellation then
% collapses 27 edges to 3 in five steps.
@misc{NETLISTVIEW,
  section = {tooling},
  claim   = {the constraint netlist is emitted as a graph that renders, with every node present and every family distinguishable, and as an elimination sequence whose fill-in is drawn},
  rests-on = {RELATIONS},
  check   = {tool:check_netlist_render.py}
}

% ⚑ A PICTURE THAT RENDERS IS NOT A PICTURE THAT IS LEGIBLE, and no check can
% assert the second. This one asserts the dot LOADS, the family colours SURVIVE
% INTO THE SVG (the `edgecolor=` lesson: an attribute graphviz does not have parses
% fine and draws everything black), every node appears, and the frame count matches
% the elimination length. Whether 21 nodes lay out readably is a question only
% LOOKING answers, which is why --write emits the files.
@misc{NETLISTVIEW-SEES,
  section = {tooling},
  claim   = {the render witness is proven to see a missing node, a family whose colour never reaches the output, and an empty elimination sequence},
  rests-on = {NETLISTVIEW},
  check   = {tool:check_netlist_render.py --selftest}
}

% ── emitters ─────────────────────────────────────────────────────────────────
% ⚑ THE DESIGN'S CORE RISK.  Every emission target reads the SAME palette
% tokens so the targets cannot drift apart; a claim that they agree is therefore
% a claim about the whole system, not about one file.
@misc{TOKENS,
  section = {emitters},
  claim   = {every emission target reads its colours from the one palette, so no target can drift from the scheme},
  check   = {tool:check_token_source.py}
}

% ⚑ THE WITNESS COMPILING WAS TOO WEAK TO BE.  Three defects hid behind
% @COMPILES — all in files the archive marked partial, none a syntax error: a
% module-level forward reference, a mangled identifier, and a plural/singular API
% mismatch.  A generator's job is to WRITE something, so the check runs it.
@misc{EMITTERS,
  section = {emitters},
  claim   = {every generator actually runs and writes its artifact, in dependency order, rather than merely compiling},
  rests-on = {COMPILES, TOKENS},
  check   = {tool:check_emitters_run.py}
}

@misc{CHROME,
  section = {emitters},
  claim   = {the browser theme emits a valid manifest for every declared variant},
  rests-on = {TOKENS},
  check   = {tool:check_chrome.py}
}

% ⚑ OPEN, AND CORRECTLY RED.  Selection/ForegroundActive is illegible in ALL SIX
% variants — measured 1.01:1 to 2.01:1 against its own background, where the
% ForegroundNormal beside it runs 6.3:1 to 12.8:1.  It is too dark on the lit
% variants and too bright on the rest, so no single literal fixes it: the token
% choice itself is wrong for the one group where the palette inverts.  Found by
% measuring, after repairing make_schemes.py made the value visible; the bug
% predates the repair.  This claim stays undischarged until the token is fixed —
% lowering the floor to make it green would be recording a decision as a fact.
@misc{SELECTION,
  section = {emitters},
  claim   = {text on the lit selection background clears the legibility floor in every variant},
  rests-on = {EMITTERS},
  check   = {tool:check_selection_contrast.py}
}

% ⚑ THE BREAK THAT NOTHING CAUGHT.  8 of the 10 cvd_gate attributes consumers call
% went missing in the recovery — WCAG, APCA, the ghost derivations, the gate's own
% normalized-q metric — so make_palette could not import and make_schemes fell back
% to the authored table. Every file byte-compiled; the only symptom was a washed-out
% palette. @COMPILES said so about itself, and @CONSUMERS' roster was the gap: it
% covered the segment pipeline and not the colour chain.
@misc{PALETTE-CHAIN,
  section = {emitters},
  claim   = {the colour chain imports and solves, so the shipped schemes are solver output rather than whatever a silent fallback produced},
  rests-on = {CONSUMERS},
  check   = {tool:check_palette_chain.py}
}

% ⚑ CITED, NOT RE-AUTHORED.  `concept:` imports a witness the LIBRARY owns and
% grades. The alternative — a scripts/check_*.py asking the same question — is how
% two views end up certifying different answers to one fact: fix one, and the
% other keeps passing on the old one.
@misc{SAMPLES,
  section = {emitters},
  claim   = {the theme is rendered into a sample library, so it can be looked at rather than only described},
  rests-on = {TOKENS},
  check   = {concept:samples-exist}
}

% ⚑ BOTH OF THESE CAME FROM LOOKING AT THE PICTURES, AND NEITHER WAS REACHABLE BY
% ANY CHECK THAT EXISTED.  Every colour gate here asks whether something is
% legible AGAINST A BACKGROUND; both of these pass that and fail anyway — one
% role indistinguishable from another role, and a layout that clips. The library
% paid for itself the first time it was opened.
@misc{ROLES,
  section = {emitters},
  claim   = {each palette role renders as its own colour, so the focus ring can be told from the body text it surrounds},
  rests-on = {SAMPLES},
  check   = {concept:palette-roles-distinct}
}

% ⚑ AN ARTIFACT EMBEDDED IN A PROGRAM IS UN-PREVIEWABLE.  Seven markup documents
% — QML components, kcfg XML, an SVG — were held as Python string literals: no
% viewer opens them, qmllint cannot reach them, and a diff says "the .py changed"
% rather than which element moved. The 87-line SegmentChar is the sharpest case,
% since it is the very artifact ⊕SEGMENT-SUBSTRATE wires into four surfaces.
% Templates also end the brace-doubling that QML forces on an f-string.
@misc{TEMPLATES,
  section = {emitters},
  claim   = {no generator holds a markup document as a string literal; each reads a template file that can be opened, linted and previewed on its own},
  rests-on = {EMITTERS},
  check   = {tool:check_embedded_markup.py}
}

% ⚑ EXTRACTION MUST BE OUTPUT-NEUTRAL, AND SAYING SO IS NOT SHOWING IT.  Moving a
% document out of an f-string means re-typing dozens of doubled brace pairs as
% singles and every {name} hole as $name — the edit that still parses, still
% lints, and emits subtly different markup. The baseline is recorded BEFORE the
% rewrite (capture_baseline refuses to overwrite one, so it cannot drift to match
% the code) and this asserts the generator still reproduces it.
@misc{PARITY,
  section = {emitters},
  claim   = {every extracted template still emits its pre-extraction baseline byte for byte, so moving an artifact to a file changed no output},
  rests-on = {TEMPLATES},
  check   = {tool:check_template_parity.py}
}

% ⚑ GEOMETRY IS A TOKEN SET EXACTLY LIKE COLOUR, and this is @TOKENS on the
% shape axis. Four surfaces each re-implemented the segment shapes while
% segment_topology — the emitter built to supply them — fed none of them. The
% clock went further and re-read the wallpaper's SOURCE with a regex, so its
% geometry depended on another file's literal syntax rather than any interface.
% A surface chooses a FORMAT ("7" digits / "22" alphanumeric); carrying a stroke
% table is a re-implementation.
@misc{GEOMETRY,
  section = {emitters},
  claim   = {every segment surface renders from the one geometry substrate rather than carrying its own stroke table},
  rests-on = {TOKENS},
  check   = {tool:check_geometry_source.py}
