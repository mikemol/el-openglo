% warrants.bib — the el-openglo worklist as a claim-DAG.
%
% THE GOVERNING INVARIANT: every claim here is UNDISCHARGED until its check
% passes, and the item is incomplete until it can be discharged.  Those are the
% same fact — a claim whose check exits non-zero is a claim the gate refuses to
% certify, so `open item` and `red check` are one state, computed fresh on every
% run.
%
% ⚑ THERE IS NO open/closed FIELD, AND THERE MUST NEVER BE ONE.  Openness is
% computed from exit codes; nothing records it, so nothing about it can go
% stale.  Recording open-ness is precisely the failure mode this design exists
% to dissolve — and this repo is a RECOVERY, where a stale status note is
% exactly what went wrong: RECOVERY-NOTES.md still calls the segment API "the
% main rebuild gap" after most of it had been recovered.
%
% `claim` is the COMMITMENT — one line.  The finding it came from lives in the
% plan and in COTYPE.md.  Do not grow these into paragraphs: the one-line limit
% is what forces a figure into a checkable [tag].
%
% `rests-on` is GROUNDING (a claim cannot be TRUE unless its premises are);
% prose order is separate.  Do not conflate the two.
%
% This file is SOURCE and is meant to be edited.  WORKLIST.md is the projection
% and must never be hand-edited — the gate refuses it.
%
% ⚑ ON NAMING: this document must never spell the retired mark, or the very
% file certifying its absence would be a counterexample to its own claim.  It is
% "the prior mark" throughout, and scripts/check_mark.py is its only speller.

% ── rename ───────────────────────────────────────────────────────────────────
@misc{MARK,
  section = {rename},
  claim   = {no file in the tree carries the prior mark, outside the historical records that must quote it},
  check   = {tool:check_mark.py}
}

@misc{MARK-SEES,
  section = {rename},
  claim   = {the scrub's own scan is proven able to SEE the mark, so its all-clear is a measurement rather than a blind spot},
  rests-on = {MARK},
  check   = {tool:check_mark.py --selftest}
}

% ── recovery ─────────────────────────────────────────────────────────────────
% ⚑ The archive shipped 8 files marked ** PARTIAL ** — replayed to an
% INTERMEDIATE state because a later edit's anchor text was not found.  They all
% BYTE-COMPILE, which is exactly why compiling is too weak a witness to certify
% them: the recovery's own honesty is that they may be syntactically fine and
% behaviourally wrong.  Compilation is claimed here as what it is, and no more.
@misc{COMPILES,
  section = {recovery},
  claim   = {every recovered generator byte-compiles},
  check   = {tool:check_compiles.py}
}

@misc{PARTIAL,
  section = {recovery},
  claim   = {every file the archive marked partial is still recorded as partial, so a syntactically-clean file is never mistaken for a verified one},
  rests-on = {COMPILES},
  check   = {tool:check_partial.py}
}

@misc{DEPS,
  section = {recovery},
  claim   = {every third-party import in the tree is accounted for in one manifest, declared or recorded as deliberately absent},
  check   = {tool:check_deps.py}
}

% ── pipeline ─────────────────────────────────────────────────────────────────
% ⚑ THE ONE REAL RECOVERY GAP.  Consumers import ST.SEG22 / ST.GEOM22; the
% recovered segment_topology.py defines neither.  Everything else the recovery
% notes called missing (the FORMATS lattice, project(), the glyph tables) was
% verified PRESENT — that note is stale, which is the standing argument for
% computing status instead of recording it.
@misc{ST22,
  section = {pipeline},
  claim   = {segment_topology exports the 22-segment geometry its consumers import},
  check   = {tool:check_st_api.py}
}

@misc{ST-ADD,
  section = {pipeline},
  claim   = {the endpoint and display-geometry helpers shipped as a separate additions file are merged into the module that owns them},
  check   = {stsym:endpoints}
}

@misc{CONSUMERS,
  section = {pipeline},
  claim   = {the matcher and the showcase renderer import cleanly against that geometry},
  rests-on = {ST22, ST-ADD},
  check   = {tool:check_consumers.py}
}

% ── emitters ─────────────────────────────────────────────────────────────────
% ⚑ THE DESIGN'S CORE RISK.  Every emission target reads the SAME palette
% tokens so the targets cannot drift apart; a claim that they agree is therefore
% a claim about the whole system, not about one file.
@misc{TOKENS,
  section = {emitters},
  claim   = {every emission target reads its colours from the one palette, so no target can drift from the scheme},
  check   = {tool:check_token_source.py}
}

% ⚑ THE WITNESS COMPILING WAS TOO WEAK TO BE.  Three defects hid behind
% @COMPILES — all in files the archive marked partial, none a syntax error: a
% module-level forward reference, a mangled identifier, and a plural/singular API
% mismatch.  A generator's job is to WRITE something, so the check runs it.
@misc{EMITTERS,
  section = {emitters},
  claim   = {every generator actually runs and writes its artifact, in dependency order, rather than merely compiling},
  rests-on = {COMPILES, TOKENS},
  check   = {tool:check_emitters_run.py}
}

@misc{CHROME,
  section = {emitters},
  claim   = {the browser theme emits a valid manifest for every declared variant},
  rests-on = {TOKENS},
  check   = {tool:check_chrome.py}
}

% ⚑ OPEN, AND CORRECTLY RED.  Selection/ForegroundActive is illegible in ALL SIX
% variants — measured 1.01:1 to 2.01:1 against its own background, where the
% ForegroundNormal beside it runs 6.3:1 to 12.8:1.  It is too dark on the lit
% variants and too bright on the rest, so no single literal fixes it: the token
% choice itself is wrong for the one group where the palette inverts.  Found by
% measuring, after repairing make_schemes.py made the value visible; the bug
% predates the repair.  This claim stays undischarged until the token is fixed —
% lowering the floor to make it green would be recording a decision as a fact.
@misc{SELECTION,
  section = {emitters},
  claim   = {text on the lit selection background clears the legibility floor in every variant},
  rests-on = {EMITTERS},
  check   = {tool:check_selection_contrast.py}
}

% ⚑ THE BREAK THAT NOTHING CAUGHT.  8 of the 10 cvd_gate attributes consumers call
% went missing in the recovery — WCAG, APCA, the ghost derivations, the gate's own
% normalized-q metric — so make_palette could not import and make_schemes fell back
% to the authored table. Every file byte-compiled; the only symptom was a washed-out
% palette. @COMPILES said so about itself, and @CONSUMERS' roster was the gap: it
% covered the segment pipeline and not the colour chain.
@misc{PALETTE-CHAIN,
  section = {emitters},
  claim   = {the colour chain imports and solves, so the shipped schemes are solver output rather than whatever a silent fallback produced},
  rests-on = {CONSUMERS},
  check   = {tool:check_palette_chain.py}
}

% ⚑ CITED, NOT RE-AUTHORED.  `concept:` imports a witness the LIBRARY owns and
% grades. The alternative — a scripts/check_*.py asking the same question — is how
% two views end up certifying different answers to one fact: fix one, and the
% other keeps passing on the old one.
@misc{SAMPLES,
  section = {emitters},
  claim   = {the theme is rendered into a sample library, so it can be looked at rather than only described},
  rests-on = {TOKENS},
  check   = {concept:samples-exist}
}

% ⚑ BOTH OF THESE CAME FROM LOOKING AT THE PICTURES, AND NEITHER WAS REACHABLE BY
% ANY CHECK THAT EXISTED.  Every colour gate here asks whether something is
% legible AGAINST A BACKGROUND; both of these pass that and fail anyway — one
% role indistinguishable from another role, and a layout that clips. The library
% paid for itself the first time it was opened.
@misc{ROLES,
  section = {emitters},
  claim   = {each palette role renders as its own colour, so the focus ring can be told from the body text it surrounds},
  rests-on = {SAMPLES},
  check   = {concept:palette-roles-distinct}
}

% ⚑ AN ARTIFACT EMBEDDED IN A PROGRAM IS UN-PREVIEWABLE.  Seven markup documents
% — QML components, kcfg XML, an SVG — were held as Python string literals: no
% viewer opens them, qmllint cannot reach them, and a diff says "the .py changed"
% rather than which element moved. The 87-line SegmentChar is the sharpest case,
% since it is the very artifact ⊕SEGMENT-SUBSTRATE wires into four surfaces.
% Templates also end the brace-doubling that QML forces on an f-string.
@misc{TEMPLATES,
  section = {emitters},
  claim   = {no generator holds a markup document as a string literal; each reads a template file that can be opened, linted and previewed on its own},
  rests-on = {EMITTERS},
  check   = {tool:check_embedded_markup.py}
}

% ⚑ THE WITNESS I DID NOT HAVE WHEN I NEEDED IT.  I read an offset ghost layer
% off the wallpaper sample and filed it as a finding; the transforms are
% identical. An unparameterised witness reaches for whatever state is at hand,
% and here that was my impression of a picture. This one takes the SVG.
@misc{GHOSTREG,
  section = {emitters},
  claim   = {the wallpaper's ghost field registers exactly under its lit digits, rather than reading as a second display},
  rests-on = {SAMPLES},
  check   = {concept:ghost-registers}
}

@misc{CLOCKFIT,
  section = {emitters},
  claim   = {the rendered clock digits fit inside their bezel rather than clipping at its edge},
  rests-on = {SAMPLES},
  check   = {concept:preview-clock-fits}
}

@misc{STANDARDS,
  section = {emitters},
  claim   = {every external standard this project applies is recorded with the module that applies it, and every cited applier still exists},
  rests-on = {PALETTE-CHAIN},
  check   = {tool:check_standards.py}
}

% ── tooling ──────────────────────────────────────────────────────────────────
@misc{HOOKS,
  section = {tooling},
  claim   = {the borrowed structural hooks pass their own selftests when run from this repo rather than the one they were written in},
  check   = {tool:check_hooks.py}
}

@misc{ROUTES,
  section = {tooling},
  claim   = {the structural-query hook reads a non-empty routing table of this repo's own, rather than degrading silently to a contentless refusal},
  rests-on = {HOOKS},
  check   = {tool:check_routes.py}
}

% ⚑ THE DESIGN LOG IS READ BY A TOOL, NOT BY EYE.  COTYPE.md is 4,600 lines
% across 72 sessions; "what is still open?" answered by reading it is both the
% shape the standing rule forbids and, at that length, simply unreliable.  Its
% own claim graph lives in catalog/cotype/ and is gated alongside this one.
@misc{COTYPE,
  section = {tooling},
  claim   = {the design log is read structurally rather than by eye, so its open work and its self-contradictions are computed instead of recalled},
  check   = {tool:cotype_index.py --selftest}
}

% ── decide ───────────────────────────────────────────────────────────────────
% ⚑ A DECISION ITEM IS CLOSED WHILE DECIDED — it is not debt.  Its witness
% discriminates on whether the decision is LEGIBLE (recorded where a reader will
% find it), never on whether it was the right call.  There is deliberately no
% always-true `premise:` verb here: paperkit's own Δ grader marks a check that
% cannot fail `indeterminate`, and an unfalsifiable claim the gate certifies is
% worse than no claim at all.
@misc{SCOPE,
  section = {decide},
  claim   = {the decision to retire the prior mark everywhere, including descriptive prose, is recorded where a reader meets the rename},
  check   = {tool:check_scope_recorded.py}
}
