% concepts.bib — the concepts this library OWNS and grades.
%
% A concept is authored once here and its witness lives in concepts.py. Any view
% that cites it resolves `concept:<key>` by IMPORTING that proof rather than
% re-authoring a parallel, and usually weaker, one.
%
% ⚑ THE LIBRARY EXISTS TO BE LOOKED AT.  library/samples/ holds the theme
% rendered — one swatch and one preview per variant — because nine emitters in
% this tree produce images and every one of them wrote to /tmp or to a gitignored
% path. The theme was fully generated, fully gated, and completely invisible.
% These concepts are what keep the thing you look at honest.
%
% ⚑ AND LOOKING WORKED.  `palette-roles-distinct` exists because the swatch made
% a defect visible that no gate had asked about: `phosphor` and `accent` render
% as ONE colour in all six variants (Button/DecorationFocus == View/
% ForegroundNormal, byte for byte), while the README gives them different jobs —
% body text and the focus ring. Every existing check asked whether a colour was
% legible AGAINST A BACKGROUND; both of these are perfectly legible, just not
% from each other. That is a different question, and only a picture asked it.

@misc{samples-exist,
  section = {library},
  claim   = {every declared sample is present and non-empty, so the library is a place where something can actually be seen},
  check   = {cmd:python3 concepts.py samples-exist}
}

@misc{index-generated,
  section = {library},
  claim   = {the index names exactly the samples that exist, having been regenerated rather than hand-edited},
  rests-on = {samples-exist},
  check   = {cmd:python3 concepts.py index-generated}
}

% ⚑ AND LOOKING FOUND A SECOND ONE.  Every preview clips the final `0` of `12:00`
% against its bezel, in all six variants. The PNG is valid, the colours are
% right, every contrast check passes — the artifact is correct and the LAYOUT is
% wrong, which is a property only a rendering has. Two findings from one
% afternoon of pictures, neither reachable by any check that existed.
@misc{preview-clock-fits,
  section = {library},
  claim   = {the preview's clock digits fit inside their bezel rather than clipping at its edge},
  rests-on = {samples-exist},
  check   = {cmd:python3 concepts.py preview-clock-fits}
}

% ⚑ AUTHORED AFTER BEING WRONG WITHOUT IT.  Looking at the wallpaper sample I
% reported "an offset ghost layer reading as a second overlapping clock" and
% filed it as a predicted defect. The transforms are identical; what I saw was
% the ghost 88:88 showing around the lit 12:00, which is the motif. My eyes were
% the witness, and an unparameterised witness reaches for whatever state is at
% hand — here, an impression of a picture.
%
% It takes the SVG as an argument, so the selftest can hand it a deliberately
% offset file and prove it fails. It asserts the RELATION (every lit group has a
% ghost at the same origin) rather than the coordinates, so the clock may move.
@misc{ghost-registers,
  section = {library},
  claim   = {the ghost segment field registers exactly under the lit digits, so it reads as the unlit surface behind them rather than as a second display},
  rests-on = {samples-exist},
  check   = {cmd:python3 concepts.py ghost-registers}
}

@misc{palette-roles-distinct,
  section = {library},
  claim   = {each palette role renders as its own colour, so a role can be told apart from the others and not merely read against the background},
  rests-on = {samples-exist},
  check   = {cmd:python3 concepts.py palette-roles-distinct}
}

% ⚑ AND LOOKING FOUND A THIRD — then caught the SAMPLE being blind to it.
% The 5x7 'A' shipped malformed (crossbar one row low, flat apex) and no check
% could see it: check_display_registry compares the emission to registry(),
% Python to Python, so a wrong glyph round-trips perfectly, and the 5x7 collision
% count stays 0 because a malformed 'A' still differs from every other letter.
% Rendering the ticker caught it, exactly as a rendered sample caught plymouth's
% clipped digits.
%
% Then the fix re-rendered BYTE-IDENTICAL, because the sample read
% "EL OPENGLO 13:37" — which contains no 'A'. The defect was real, the fix was
% real, and the witness was blind to both. A sample that cannot show the defect
% is not a witness for it, so coverage of the FONT is now asserted separately
% from coverage of the surface.
@misc{marquee-covers-font,
  section = {library},
  claim   = {the marquee sample renders every glyph the font declares, so a malformed glyph is visible in the picture rather than only in the glyphs the sample happens to contain},
  rests-on = {samples-exist},
  check   = {cmd:python3 concepts.py marquee-covers-font}
}
