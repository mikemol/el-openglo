<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
  <kcfgfile name=""/>
  <group name="General">
    <!-- DISPLAY layer: display_params.MOUNTS['wallpaper'] (do not hand-edit here) -->
    <entry name="showGhost" type="Bool"><default>true</default></entry>
    <!-- ghostOpacity: the DEFAULT is the palette's SOLVED glanced-at ghost alpha, filled at emit time; the slider is a per-user override, never the source -->
    <entry name="ghostAlpha" type="Double"><default>0.309</default></entry>
    <entry name="weight" type="Double"><default>1.0</default></entry>
    <entry name="ghostWeight" type="Double"><default>0.81</default></entry>
    <!-- pitch: in segLen: the gap between digit boxes; the default and the slider's floor are the module pitch itself, and the face is fitted to the frame with it -->
    <entry name="digitGap" type="Double"><default>0.786</default></entry>
    <entry name="bloom" type="Double"><default>1.5</default></entry>
    <entry name="haloOpacity" type="Double"><default>0.75</default></entry>
    <entry name="litGradient" type="Double"><default>0.35</default></entry>
    <entry name="boundaryDepth" type="Double"><default>0.5</default></entry>
    <entry name="glow" type="Double"><default>1.0</default></entry>
    <!-- MOUNT layer: this wallpaper's own -->
    <entry name="breathe" type="Bool"><default>false</default></entry>
    <entry name="blinkColon" type="Bool"><default>true</default></entry>
  </group>
</kcfg>
