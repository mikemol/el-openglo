% readme.bib — README.md as a claim-DAG (W69).
%
% ⚑ README.md IS GENERATED FROM THIS FILE. Never hand-edit README.md: the gate
% refuses drift between it and the projection. Edit here, then
%     python3 scripts/worklist_gate.py --project
%
% ⚑ EVERY SENTENCE IS A CAPABILITY THAT A CHECK ALREADY GATES. A claim cites the
% check that can make it false — never "X exists". Where the only check is weak
% (it reports n of n over a measured n, so a deletion shrinks the population and
% stays green), the claim still cites it: a projection cannot drift from its
% graph whatever the checks' strength, and a weak claim on the front page makes
% its weakness visible rather than hiding it in a file nobody opens.
%
% ⚑ POPULATIONS ARE NOT TYPED HERE. The roster, the palette, the closed
% capabilities and the pictures are written by scripts/readme_fragments.py from
% the tools that declare them (emitters.ROLES, make_preview.parse_scheme,
% check_symbol.CLOSED, render_screens.plan_all) and placed as `emit:` assets.
% policy/readme.rego (via opa_gate.py readme) denies a stale fragment AND a
% declared item the page does not name.

% ── lede ─────────────────────────────────────────────────────────────────────
@misc{LOOK,
  section = {lede},
  claim   = {EL Openglo is the look of a ZnS:Cu electroluminescent backlight — a near-black LCD panel, a blue-green phosphor glow near 505 nm, unlit "ghost" segments that stay faintly visible, and one deliberate inversion: selecting anything switches the backlight on, the way the whole panel lit while you held the button down, and the text on that lit selection clears the legibility floor in every variant},
  check   = {tool:check_selection_contrast.py}
}

@misc{ONE-PALETTE,
  section = {lede},
  claim   = {Everything is generated: the palette is solved once and every emission target reads its colours from it, so no two surfaces can drift apart},
  check   = {tool:check_token_source.py}
}

@misc{RUNS,
  section = {lede},
  claim   = {Every generator actually runs and writes its artifact, in dependency order, rather than merely compiling},
  rests-on = {ONE-PALETTE},
  check   = {tool:check_emitters_run.py}
}

% ── variants ─────────────────────────────────────────────────────────────────
@misc{SIX,
  section = {variants},
  claim   = {Six variants ship: EL-Openglo (the blue-green phosphor), EL-Azure and EL-Amber (amber EL panels were real too), and the backlit form of each — EL-Openglo-Lit, EL-Azure-Lit and EL-Amber-Lit — where the panel is the lit backlight and the digits are dark; every separation pair the palette declares enforced clears the colour-vision-deficiency floor in all six},
  rests-on = {ONE-PALETTE},
  check   = {tool:check_separation.py}
}

@misc{STATES,
  section = {variants},
  claim   = {In every variant the three decoration states — focus ring, selection field, hover ring — stay pairwise distinguishable},
  rests-on = {SIX},
  check   = {tool:check_states.py}
}

