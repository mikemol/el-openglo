graph netlist {
  graph [fontname="monospace", labelloc="t", fontsize=11];
  node  [fontname="monospace", fontsize=10, shape=ellipse];
  edge  [fontname="monospace", fontsize=8];
  label="the constraint netlist — 22 nodes, 47 edges\nb1 = 24 independent cycles; terminals are boxed";
  "aperture" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "cell" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "collinear_join" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "dot_fill" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "dot_gap" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "end_gap" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "fg" [shape=box, penwidth=2.4, style=filled, fillcolor="white"];
  "fg_act" [shape=box, penwidth=2.4, style=filled, fillcolor="white"];
  "fg_in" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "focus" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "ghost_stroke" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "hover" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "link" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "lit_stroke" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "neg" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "neu" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "pos" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "sel_act" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "sel_bg" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "sel_fg" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "view" [shape=box, penwidth=2.4, style=filled, fillcolor="white"];
  "visited" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "neg" -- "neu" [color="#0072b2", style=solid, penwidth=2.0];
  "neg" -- "pos" [color="#0072b2", style=solid, penwidth=2.0];
  "neg" -- "link" [color="#0072b2", style=solid, penwidth=2.0];
  "neg" -- "visited" [color="#0072b2", style=solid, penwidth=2.0];
  "neg" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "neu" -- "pos" [color="#0072b2", style=solid, penwidth=2.0];
  "neu" -- "link" [color="#0072b2", style=solid, penwidth=2.0];
  "neu" -- "visited" [color="#0072b2", style=solid, penwidth=2.0];
  "neu" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "pos" -- "link" [color="#0072b2", style=solid, penwidth=2.0];
  "pos" -- "visited" [color="#0072b2", style=solid, penwidth=2.0];
  "pos" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "link" -- "visited" [color="#0072b2", style=solid, penwidth=2.0];
  "link" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "visited" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "focus" -- "neu" [color="#0072b2", style=solid, penwidth=2.0];
  "focus" -- "link" [color="#0072b2", style=solid, penwidth=2.0];
  "focus" -- "neg" [color="#0072b2", style=solid, penwidth=2.0];
  "focus" -- "pos" [color="#0072b2", style=solid, penwidth=2.0];
  "fg" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "fg_in" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "fg_in" -- "fg" [color="#009e73", style=solid, penwidth=2.0];
  "fg_act" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "sel_fg" -- "sel_bg" [color="#009e73", style=solid];
  "sel_act" -- "sel_bg" [color="#009e73", style=solid];
  "neg" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "neg" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "neu" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "neu" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "pos" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "pos" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "link" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "link" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "visited" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "visited" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "lit_stroke" -- "ghost_stroke" [color="#d55e00", style=solid];
  "lit_stroke" -- "aperture" [color="#d55e00", style=solid];
  "end_gap" -- "collinear_join" [color="#d55e00", style=solid];
  "dot_fill" -- "dot_gap" [color="#d55e00", style=solid];
  "cell" -- "lit_stroke" [color="#d55e00", style=solid];
  "fg_in" -- "ghost_stroke" [color="#d55e00", style=solid];
  "fg_act" -- "hover" [color="#cc79a7", style=dashed];
  "fg_act" -- "sel_bg" [color="#cc79a7", style=dashed];
  "view" -- "sel_act" [color="#cc79a7", style=dashed];
  "view" -- "sel_fg" [color="#cc79a7", style=dashed];
}
