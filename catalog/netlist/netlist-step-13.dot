graph netlist {
  graph [fontname="monospace", labelloc="t", fontsize=11];
  node  [fontname="monospace", fontsize=10, shape=ellipse];
  edge  [fontname="monospace", fontsize=8];
  label="elimination step 13 of 15 — eliminated neu\n8 nodes, 10 edges, 53 Q spent";
  "aperture" [style=dotted, color="#999999", fontcolor="#999999"];
  "cell" [style=dotted, color="#999999", fontcolor="#999999"];
  "collinear_join" [style=dotted, color="#999999", fontcolor="#999999"];
  "dot_fill" [style=dotted, color="#999999", fontcolor="#999999"];
  "dot_gap" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "end_gap" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="#eeeeee"];
  "fg" [shape=box, penwidth=2.4, style=filled, fillcolor="white"];
  "fg_act" [shape=box, penwidth=2.4, style=filled, fillcolor="white"];
  "fg_in" [style=dotted, color="#999999", fontcolor="#999999"];
  "focus" [style=dotted, color="#999999", fontcolor="#999999"];
  "ghost_stroke" [style=dotted, color="#999999", fontcolor="#999999"];
  "hover" [style=dotted, color="#999999", fontcolor="#999999"];
  "link" [style=dotted, color="#999999", fontcolor="#999999"];
  "lit_stroke" [style=dotted, color="#999999", fontcolor="#999999"];
  "neg" [style=dotted, color="#999999", fontcolor="#999999"];
  "neu" [style=dotted, color="#999999", fontcolor="#999999"];
  "pos" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "sel_act" [style=dotted, color="#999999", fontcolor="#999999"];
  "sel_bg" [style=dotted, color="#999999", fontcolor="#999999"];
  "sel_fg" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "view" [shape=box, penwidth=2.4, style=filled, fillcolor="white"];
  "visited" [shape=ellipse, penwidth=1.0, style=filled, fillcolor="white"];
  "neg" -- "neu" [color="#dddddd", style=dotted];
  "neg" -- "pos" [color="#dddddd", style=dotted];
  "neg" -- "link" [color="#dddddd", style=dotted];
  "neg" -- "visited" [color="#dddddd", style=dotted];
  "neg" -- "fg" [color="#dddddd", style=dotted];
  "neu" -- "pos" [color="#dddddd", style=dotted];
  "neu" -- "link" [color="#dddddd", style=dotted];
  "neu" -- "visited" [color="#dddddd", style=dotted];
  "neu" -- "fg" [color="#dddddd", style=dotted];
  "pos" -- "link" [color="#dddddd", style=dotted];
  "pos" -- "visited" [color="#0072b2", style=solid, penwidth=2.0];
  "pos" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "link" -- "visited" [color="#dddddd", style=dotted];
  "link" -- "fg" [color="#dddddd", style=dotted];
  "visited" -- "fg" [color="#0072b2", style=solid, penwidth=2.0];
  "focus" -- "neu" [color="#dddddd", style=dotted];
  "focus" -- "link" [color="#dddddd", style=dotted];
  "focus" -- "neg" [color="#dddddd", style=dotted];
  "focus" -- "pos" [color="#dddddd", style=dotted];
  "fg" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "fg_in" -- "view" [color="#dddddd", style=dotted];
  "fg_in" -- "fg" [color="#dddddd", style=dotted];
  "fg_act" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "sel_fg" -- "sel_bg" [color="#dddddd", style=dotted];
  "sel_act" -- "sel_bg" [color="#dddddd", style=dotted];
  "neg" -- "view" [color="#dddddd", style=dotted];
  "neg" -- "fg_act" [color="#dddddd", style=dotted];
  "neu" -- "view" [color="#dddddd", style=dotted];
  "neu" -- "fg_act" [color="#dddddd", style=dotted];
  "pos" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "pos" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "link" -- "view" [color="#dddddd", style=dotted];
  "link" -- "fg_act" [color="#dddddd", style=dotted];
  "visited" -- "view" [color="#009e73", style=solid, penwidth=2.0];
  "visited" -- "fg_act" [color="#0072b2", style=solid, penwidth=2.0];
  "lit_stroke" -- "ghost_stroke" [color="#dddddd", style=dotted];
  "lit_stroke" -- "aperture" [color="#dddddd", style=dotted];
  "end_gap" -- "collinear_join" [color="#dddddd", style=dotted];
  "dot_fill" -- "dot_gap" [color="#dddddd", style=dotted];
  "cell" -- "lit_stroke" [color="#dddddd", style=dotted];
  "fg_in" -- "ghost_stroke" [color="#dddddd", style=dotted];
  "fg_act" -- "hover" [color="#dddddd", style=dotted];
  "fg_act" -- "sel_bg" [color="#dddddd", style=dotted];
  "view" -- "sel_act" [color="#dddddd", style=dotted];
  "view" -- "sel_fg" [color="#dddddd", style=dotted];
}
