<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0">
 <kcfgfile name=""/>
 <group name="General">
  <!-- scroll speed as a factor on the length-scaled duration: 1 = the authored pace -->
  <entry name="speed" type="Double"><default>1.0</default></entry>
  <!-- dot pitch as a fraction of the panel-derived pitch -->
  <entry name="pitchScale" type="Double"><default>1.0</default></entry>
  <!-- dot diameter as a fraction of the pitch (MatrixChar.dotFill's authored 0.82) -->
  <entry name="dotFill" type="Double"><default>0.82</default></entry>
  <!-- the unlit field's opacity: the DEFAULT is the palette's SOLVED ghost alpha,
       filled at emit time; the slider is a per-user override, never the source -->
  <entry name="ghostAlpha" type="Double"><default>$ghostAlpha</default></entry>
  <entry name="showField" type="Bool"><default>true</default></entry>
  <!-- shown lit on the field when there is nothing to scroll; empty = the bare field -->
  <entry name="idleText" type="String"><default></default></entry>
  <entry name="maxItems" type="Int"><default>12</default></entry>
  <!-- a tap on a link run opens it externally (W40) -->
  <entry name="openLinks" type="Bool"><default>true</default></entry>
  <!-- hovering the board pauses the scroll so a link can be aimed at (W40); a pointer
       parked on the panel then holds the board still, so it is a choice (W49) -->
  <entry name="hoverPause" type="Bool"><default>true</default></entry>
  <!-- print every rebuild / swap / start to plasmashell's stderr (the live host's
       twin of check_marquee_live's trace) -->
  <!-- ON while VER-MARQUEE is live (operator: "check the logs yourself on
       ticks"): a plasmashell started from a terminal is unreadable except through
       the config below, so the shipped default logs; it returns to false when the
       live symbol closes -->
  <entry name="debugLog" type="Bool"><default>true</default></entry>
  <!-- the last lines of that log, kept HERE so a reader without the shell's stderr
       (a plasmashell started from a terminal logs to that terminal) can still read
       them from the appletsrc on disk; check_marquee_host.py does -->
  <entry name="traceLog" type="String"><default></default></entry>
 </group>
</kcfg>
