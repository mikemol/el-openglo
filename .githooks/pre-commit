#!/usr/bin/env bash
# Versioned pre-commit hook (enabled via: git config core.hooksPath .githooks)
#
# GATES BLOCK HERE; ADVISORIES FIRE POST-COMMIT.  A gate is a claim the tree must
# satisfy to land a commit.  An advisory has real false positives and must never
# abort a commit, so it lives in post-commit, which git cannot let fail.
#
# ⚑ EVERY GATE RUNS THROUGH `run`, WHICH IS THE CAPTURE POINT.  It times each gate
# and appends the outcome to .gate-outcomes.tsv, so gate ORDER can be derived from
# measured failure rate (fail-fast on what actually fails) instead of guessed.  A
# gate invoked directly, bypassing `run`, is invisible to that ledger — so don't.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

LEDGER="$ROOT/.gate-outcomes.tsv"
FAILED=0

# The checks import the project's declared dependencies, so they run in the
# project environment.  Outside it, a red gate would report the INTERPRETER's
# missing module as the TREE's defect.
if [ -d "$ROOT/.venv" ] && command -v uv >/dev/null 2>&1; then
  RUNNER=(uv run --no-sync python3)
else
  RUNNER=(python3)
fi

run() {
  local name="$1"; shift
  local start end rc
  start=$(date +%s%N)
  "$@"
  rc=$?
  end=$(date +%s%N)
  printf '%s\t%s\t%d\t%d\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$name" "$rc" \
      "$(( (end - start) / 1000000 ))" >> "$LEDGER"
  if [ $rc -ne 0 ]; then
    echo "pre-commit: GATE FAILED — $name" >&2
    FAILED=1
  fi
  return $rc
}

echo "── pre-commit gates ──"

# 1. The tools that answer every other question must themselves be sound.
#    ⚑ THIS RUNS FIRST BY DESIGN: a broken checker makes every gate after it a
#    lie in whichever direction the breakage leans.
#    ⚑ BOTH STREAMS ARE CAPTURED AND SHOWN ONLY ON FAILURE. A selftest proves
#    its check can REFUSE by running the refusal path on synthetic fixtures,
#    and those paths print to stderr ("SKIP — parent 'breeze' is not installed",
#    "SELFTEST-DIM: ..."). With stdout alone silenced, every passing commit
#    printed a page of fixture refusals that read as facts about the host
#    (operator, 2026-09-22: "AFAICT, I have breeze installed"). A passing
#    selftest says nothing; a failing one says everything it printed.
quiet() {  # run a gate with both streams captured; print them only when it fails
  local name="$1"; shift
  local out; out="$(mktemp)"
  local rc=0
  run "$name" "$@" >"$out" 2>&1 || rc=$?
  [ "$rc" -ne 0 ] && sed "s/^/    $name: /" "$out" >&2
  rm -f "$out"
  return "$rc"
}

# ⚑ A SELFTEST RUNS WITHOUT THE COMMIT'S GIT_* (measured 2026-10-06). Under a partial commit git
#    exports GIT_INDEX_FILE (relative, `.git/next-index-N.lock`) and GIT_DIR into this hook. A
#    selftest builds a throwaway repo (`git -C <tmp> init`, `add .`) and those calls inherit it, so
#    the files were staged into the wrong index file and the throwaway repo's own index stayed
#    empty: seven selftests read empty populations and failed under the hook and passed from a
#    shell. A selftest proves its checker can see on fixtures; it has no business with the commit's
#    index. The gates below keep the environment: they certify what is being committed.
#    EXCEPT check_ebuild: it certifies the STAGED tree (git write-tree of the commit's index), so
#    its selftest needs the commit's environment. Without it write-tree reads the REAL index,
#    which the commit holds locked, and exits 128 (measured on a throwaway repo, 2026-10-06).
#
# ⚑ THE COMMIT'S INDEX IS PASSED TO THE GATES UNDER A PAPERKIT_ NAME. paperkit's check sandbox is
#    default-deny on the environment and drops GIT_INDEX_FILE, so the @EBUILD check's write-tree
#    hit the locked real index (exit 128, the cause of the long-standing "git write-tree rc 128").
#    PAPERKIT_* passes the sandbox; check_ebuild restores it for its one call. The general fix is
#    summit's ask-project-declared-env-passthrough.
export PAPERKIT_GIT_INDEX_FILE="${GIT_INDEX_FILE:-}"

for t in "$ROOT"/scripts/check_*.py "$ROOT"/scripts/worklist_gate.py; do
  [ -e "$t" ] || continue
  name="$(basename "$t" .py)"
  if [ "$name" = "check_ebuild" ]; then
    quiet "selftest:$name" "${RUNNER[@]}" "$t" --selftest
  else
    quiet "selftest:$name" \
      env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE -u GIT_PREFIX "${RUNNER[@]}" "$t" --selftest
  fi
done

# 2. (RETIRED, W99 2026-10-02.) The PreToolUse hooks are no longer symlinks into
#    substrate: settings.json runs mtools' installed mikemol-hook-* commands, and
#    check_hooks (step 1, via its --selftest and policy/hooks.rego) measures them by
#    behaviour from here. The loop that ran the symlinks' selftests guarded on their
#    existence, so after the symlinks went it would have skipped in silence.

# 2b. THE REQUIREMENTS ARE REGO (W50): every rule's refusing and admitting case,
#    under opa test. SKIPs (exit 0, printed) when opa is absent.
quiet "opa-test" "${RUNNER[@]}" "$ROOT/scripts/opa_gate.py" --test

# 3. The segment lattice's own invariants — including the 22->16 byte-equality
#    that makes the reconstructed geometry a reconstruction rather than a guess.
quiet "segment-lattice" "${RUNNER[@]}" "$ROOT/segment_topology.py" --selftest

# 4a. WARM THE PALETTE CACHE, as a timed and ledgered step.  Importing
#    make_schemes solves the palette (~108 s cold; seconds warm), and every
#    palette check does so. Under paperkit's per-check budget a COLD cache made
#    ~13 checks time out at once and this hook refused a GREEN tree — three
#    times on 2026-09-20, each passing on the warm retry. "Retry, it was cold"
#    was a judgement living in the turn; it lives here now.
run "palette-cache" "${RUNNER[@]}" "$ROOT/make_schemes.py" --warm >/dev/null

# 4. THE WORKLIST.  Every cited claim must be discharged.  This subsumes the
#    individual checks: it is the projection over all of them.
#
#    ⚑ ONLY THE REPO'S OWN CLAIM GRAPH BLOCKS.  worklist_gate runs TWO projects:
#    catalog/worklist (claims about this tree, which a commit must satisfy) and
#    catalog/cotype (the design log's open symbols — the QUEUE, which is red for
#    exactly as long as there is work left).  Gating on both made this hook
#    unsatisfiable while any design item was open, and the measured result was
#    every commit from 2026-08-16 on landing with `--no-verify` and a stated
#    reason ("the five COTYPE buckets are open design-log symbols, red by
#    design") — a gate that is always bypassed gates nothing.  Not-blocking and
#    not-falsifiable are separable (CLAUDE.md): the cotype stays red and
#    falsifiable, reported here, and stops pretending to be a promotion gate.
#    ⚑ THE REASON IS KEPT, NOT DISCARDED.  This ran with `>/dev/null 2>&1` and
#    on refusal printed only "run it yourself". Measured in .gate-outcomes.tsv:
#    on 2026-09-20/21 three refusals took ~5 s each — fast failures, not the
#    cold-cache timeouts I diagnosed from outside — and each passed on a retry
#    forty seconds later with nothing changed. Whatever failed was never seen.
#    A gate that hides its reason turns every refusal into a guess.
WL_OUT="$(mktemp)"
run "worklist" "${RUNNER[@]}" "$ROOT/scripts/worklist_gate.py" --only worklist >"$WL_OUT" 2>&1 || {
  sed 's/^/    worklist: /' "$WL_OUT" >&2
  echo "    (run: python3 scripts/worklist_gate.py --only worklist — it names each undischarged claim)" >&2
}
rm -f "$WL_OUT"
# 4b. THE README IS A PROJECTION (W69), AND IT BLOCKS TOO.  Its claims are about
#    THIS tree — what ships, what the palette is, which emitters exist — so, like
#    the worklist and unlike the cotype queue, a red one is a defect a commit must
#    not land.  ⚑ IT WAS NEVER WIRED HERE (found 2026-09-23): W69 made README.md a
#    paperkit projection and this hook ran only `--only worklist`, so the cursors
#    commit landed with README.md not naming make_cursors and roster.tsv stale,
#    and nothing refused it. `opa_gate.py readme` saw it; no commit ever asked.
RM_OUT="$(mktemp)"
run "readme" "${RUNNER[@]}" "$ROOT/scripts/worklist_gate.py" --only readme >"$RM_OUT" 2>&1 || {
  sed 's/^/    readme: /' "$RM_OUT" >&2
  echo "    (run: python3 scripts/worklist_gate.py --only readme; stale fragments: scripts/readme_fragments.py --list)" >&2
}
rm -f "$RM_OUT"
"${RUNNER[@]}" "$ROOT/scripts/worklist_gate.py" --only cotype --summary 2>/dev/null \
  | sed 's/^/    cotype (queue, non-blocking): /' >&2 || true

if [ $FAILED -ne 0 ]; then
  echo "pre-commit: REFUSED. Fix the gate above, or --no-verify if you know why." >&2
  exit 1
fi
echo "pre-commit: all gates pass"
exit 0
