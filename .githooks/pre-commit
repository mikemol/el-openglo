#!/bin/sh
# el-openglo's pre-commit is a bazel build (design mtools:W798): the gate logic is in BUILD.bazel,
# BuildBuddy captures its logs. It runs over the STAGED tree, not the working tree (W498, under W459): the
# two diverge exactly when `git add` is partial, so gate/staged.sh materialises the commit's index at a
# stable path (its own repository, host state linked in) and `bazel test //:precommit` runs THERE.
#
# ⚑ THE MATERIALISING SCRIPT RUNS FROM A SNAPSHOT (W499): core.hooksPath points into the working tree, so git
# runs the live file, and an edit to it mid-run would be read mid-write by every commit in flight. A failed
# copy REPORTS and runs live (refusing would turn a full cache directory into a refused commit), never
# silently. The snapshot removes itself and refuses, with its reason, when a needed tool is absent.
#
# ⚑ THE `bazel test` IS HERE, IN THE HOOK, NOT BEHIND THE SCRIPT: the fleet's precommit kata (operator rule
# 2026-10-06: a repo whose precommit is a script rather than a bazel test is blocked) reads this file.
root="$(git rev-parse --show-toplevel)"
# ⚑ THE TOOLS ARE HOST STATE AND COME FROM THE REAL CHECKOUT (W508, mtools:W954). An isolated commit
# (mikemol-commit, MIKEMOL_COMMIT_ISOLATED=1) runs this hook from a snapshot of the tree that lands, which holds
# the tracked files and none of the uv venv; MIKEMOL_REAL_ROOT names the real checkout, and gate/staged.sh reads
# the venv, the host-state links and the ledger through it. Unset (a normal commit) it is $root, so nothing
# changes. The TREE gated is the index's either way.
tools="${MIKEMOL_REAL_ROOT:-$root}"
snap="${TMPDIR:-$HOME/.cache}/el-openglo-staged-$$.sh"
if cp "$root/gate/staged.sh" "$snap" 2>/dev/null; then
  staged="$(MIKEMOL_REAL_ROOT="$tools" EL_STAGED_SNAPSHOT=1 bash "$snap" --materialise)" || exit 1
else
  printf 'pre-commit: could not snapshot gate/staged.sh to %s - running it LIVE from the tree\n' "$snap" >&2
  staged="$(MIKEMOL_REAL_ROOT="$tools" "$root/gate/staged.sh" --materialise)" || exit 1
fi
cd "$staged" || exit 1
# the staged repository is self-contained: none of the commit's GIT_* (they name the REAL repository)
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
exec bazel test //:precommit --noshow_progress
