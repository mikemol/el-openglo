#!/usr/bin/env bash
# Versioned pre-merge-commit hook (enabled via: git config core.hooksPath .githooks)
#
# ⚑ NO GATED CHECK MAY WRITE THE TREE (W68), AND A MERGE IS WHERE TWO LINES OF
# WORK FIRST MEET. Operator ruling 2026-09-23: scripts/check_tree_writes.py runs
# before each PUSH and before each MERGE — not per commit, because it runs every
# worklist claim serially in a scratch copy (~190 s CPU). A merge that brings in a
# check which rewrites a tracked file mid-gate is exactly how the torn-read flakes
# of 2026-09-22/23 began (@CURRENCY probing make_schemes --keys, which emitted).
#
# git runs this only for merges that CREATE a merge commit; a fast-forward makes
# no commit and is covered by the push-side run instead. The push side is
# substrate's shared pre-push (a symlink): its per-repo extension point is asked
# of substrate, not added here.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1
if [ -d "$ROOT/.venv" ] && command -v uv >/dev/null 2>&1; then
  RUNNER=(uv run --no-sync python3)
else
  RUNNER=(python3)
fi
OUT="$(mktemp)"
if "${RUNNER[@]}" "$ROOT/scripts/opa_gate.py" tree_writes >"$OUT" 2>&1; then
  tail -1 "$OUT"
  rm -f "$OUT"
  exit 0
fi
sed 's/^/    tree_writes: /' "$OUT" >&2
rm -f "$OUT"
echo "pre-merge-commit: REFUSED — a gated check writes a tracked file (W68)." >&2
echo "    (run: python3 scripts/check_tree_writes.py --list; fix the writer, then merge)" >&2
exit 1
