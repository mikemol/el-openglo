"""el-openglo on Bazel: its pre-commit gate is a build (design mtools:W798).

Each check is a cached test over named inputs (never a glob, never a directory), so an unchanged
tree costs nothing to re-verify and a change re-runs exactly the checks whose inputs it touched.
"""

module(name = "el-openglo", version = "0.1")

bazel_dep(name = "rules_python", version = "2.3.3")

bazel_dep(name = "mikemol_rules_py", version = "0.1.0")

# Pinned at the mtools commit that carries tracked.bzl (mtools:W799). The remote is the local clone:
# the pin is the commit, so a moving working tree is never read.
git_override(
    module_name = "mikemol_rules_py",
    remote = "/home/mikemol/github/mtools",
    commit = "8baa3ef245ec0c9452ffbeafb097ec241463b195",
    strip_prefix = "rules_py",
)

tracked = use_repo_rule("@mikemol_rules_py//:tracked.bzl", "tracked_files")

tracked(name = "tracked")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.13", is_default = True)
