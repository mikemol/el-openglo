__pycache__/
*.pyc
.venv/
.gate-outcomes.tsv
.selftest-last.tsv
catalog/worklist/.delta-cache.json

# generated artifacts — emitted by the make_* generators, never source
*-wallpaper.svg
*-wallpaper.png
preview.png
# emitted theme trees (bulky SVG sets; regenerate with make_aurorae/make_plasma)
aurorae/
plasma/
union/
windows/
firefox/
gtk/
fonts/
catalog/cotype/.delta-cache.json
.palette-cache.json
# W68's flock sidecar: serialises the cold solve; empty, per-machine
.palette-cache.json.lock
# W30's compiled fonts: keyed on font sha256 + method fingerprint, per-machine
.font-cache/
# check_ebuild's work dir: the index tree staged under sys-apps/sandbox. Under
# the repo rather than /tmp because the sandbox DENIES /tmp (a build must not
# write shared temp), and DENY covers reads.
.ebuild-witness/
# check_tree_writes' scratch worktrees — under the repo for the same reason:
# @EBUILD run inside one stages under that sandbox.
.tree-writes/
# W75: content-addressed build artifacts (.build/schemes/<digest>/), materialised by
# the gate and read by every palette reader; regenerable, never source.
.build/

# ⚑ THE SAMPLE LIBRARY IS THE EXCEPTION: build output that EXISTS to be looked
# at, on GitHub, in a diff, by someone who has run nothing. A gitignored sample
# is a sample nobody sees.
!catalog/library/samples/
!catalog/library/samples/*.svg
# ⚑ AND PNG, because not every surface emits markup. Plymouth draws with Pillow,
# so its sample is a raster or it is nothing — and a raster sample is still the
# only way to see whether its digits form.
!catalog/library/samples/*.png

# The summit drop zone: incoming letters must not dirty this tree.
# Ruling: ~/github/summit/proceedings/rulings/inbox-drop-zone.md
# Ignored from HERE rather than by a file inside it, so provisioning adds nothing to git status.
/inbox/
