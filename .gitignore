__pycache__/
*.pyc
.venv/
.gate-outcomes.tsv
.selftest-last.tsv
catalog/worklist/.delta-cache.json

# generated artifacts — emitted by the make_* generators, never source
*-wallpaper.svg
*-wallpaper.png
preview.png
# emitted theme trees (bulky SVG sets; regenerate with make_aurorae/make_plasma)
aurorae/
plasma/
catalog/cotype/.delta-cache.json
.palette-cache.json

# ⚑ THE SAMPLE LIBRARY IS THE EXCEPTION: build output that EXISTS to be looked
# at, on GitHub, in a diff, by someone who has run nothing. A gitignored sample
# is a sample nobody sees.
!catalog/library/samples/
!catalog/library/samples/*.svg
# ⚑ AND PNG, because not every surface emits markup. Plymouth draws with Pillow,
# so its sample is a raster or it is nothing — and a raster sample is still the
# only way to see whether its digits form.
!catalog/library/samples/*.png
