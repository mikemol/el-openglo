# ⚑ THE PRE-COMMIT GATE IS THIS TEST SUITE (W455, W456, W491; operator rule 2026-10-06: a repo whose
# precommit is a script and not a bazel test is blocked). `.githooks/pre-commit` runs
# `bazel test //:precommit` and nothing else; the suite is one test per gate stage (gate/stage.sh runs
# one), so each stage has its own log and verdict and a flake names the stage that flaked (W454).
#
# ⚑ EVERY INPUT IS A NAMED FILE: `select_tracked` asks git for the tracked names (the index), never a
# glob and never a directory, and policy/bazel_build.rego (check_bazel_build) refuses both. A file
# tracked and gone from the work tree fails analysis naming it. A tracked file NO stage names fails the
# `census` stage (W488): its data is the union of every other stage's, and it asks what its own runfiles
# hold.
#
# ⚑⚑ THE DATA OF EVERY STAGE IS EVERY TRACKED FILE, DELIBERATELY: the fail-safe over-approximation
# (check_action_key: an over-wide domain costs a re-run, an under-wide one reads stale as current).
# W458 narrows each stage to its real closure (and the census then bites); W459 gates the staged tree
# hermetically.
load("@mikemol_rules_py//:tracked.bzl", "select_tracked")
load("@tracked//:manifest.bzl", "TRACKED")
load(":closures.bzl", "CLOSURES")
load(":stages.bzl", "closure_data", "precommit_stage")

ALL = select_tracked(TRACKED)

# every check's own --selftest, and worklist_gate's: the tools that answer every other question
# must themselves be sound, so these are the suite's first members
CHECKS = select_tracked(TRACKED, prefix = "scripts/check_", suffix = ".py") + select_tracked(TRACKED, prefix = "scripts/worklist_gate", suffix = ".py")

# ⚑ A SELFTEST STAGE'S DATA IS ITS OBSERVED CLOSURE (W495; closures.bzl is generated by
# scripts/check_closure.py --write from strace of the stage, and the closure-witness stage runs each
# stage in a tree holding only it), plus MODULE.bazel, which locates the checkout. CLOSURES[c] is a
# KeyError at analysis when a check has no closure: loud, and policy/closure.rego L1 names it first.
STAGES = [
    {
        "name": "selftest_" + c[len("scripts/"):-len(".py")],
        "args": ["selftest", c],
        "data": closure_data(CLOSURES, c),
    }
    for c in CHECKS
] + [
    {"name": "opa_test", "args": ["opa-test"], "data": closure_data(CLOSURES, "opa-test")},
    {"name": "segment_lattice", "args": ["segment-lattice"], "data": closure_data(CLOSURES, "segment-lattice")},
    # the witness runs every other stage in its own tree and reads their closures: it keeps ALL
    {"name": "closure_witness", "args": ["closure-witness"], "data": ALL},
    {"name": "worklist", "args": ["worklist"], "data": closure_data(CLOSURES, "worklist")},
    {"name": "readme", "args": ["readme"], "data": closure_data(CLOSURES, "readme")},
]

# the union of every stage's inputs, deduplicated (a dict is the set): the census stage's own data
UNION = sorted({p: True for s in STAGES for p in s["data"]}.keys())

[
    precommit_stage(
        name = s["name"],
        args = s["args"],
        data = s["data"],
    )
    for s in STAGES
]

precommit_stage(
    name = "census",
    args = ["census"],
    data = UNION,
)

test_suite(
    name = "precommit",
    tests = [":" + s["name"] for s in STAGES] + [":census"],
)
