# METADATA
# title: "S0 — no planned stills admits nothing"
# description: |
#   The measurement is `scripts/check_screens.py --json` over the plan
#   catalog/library/render_screens.py declares (five surfaces x six variants).
#
#   ⚑ EVERY STILL AND ANIMATION LANDS IN EXACTLY ONE OF withheld / deny / admitted.
#   render_screens.measure ALWAYS emits `exists` (a boolean) and, when it is true,
#   `distinct` / `modal` / `grounds` for a still and `frames` / `tears` /
#   `seamless` for an animation; the population always carries `animations`.
#   Null or absent is "could not say": S7 withholds it and no rule judges it.
package el.screens

import rego.v1

missing(obj, fields) := {f | some f in fields; object.get(obj, f, null) == null}

still_missing(s) := m if {
	object.get(s, "exists", null) == true
	m := missing(s, ["distinct", "modal", "grounds"])
} else := missing(s, ["exists"])

anim_missing(a) := m if {
	object.get(a, "exists", null) == true
	m := missing(a, ["frames", "tears", "seamless"])
} else := missing(a, ["exists"])

stills := [s | some s in object.get(input, "screens", []); count(still_missing(s)) == 0]

anims := [a | some a in object.get(input, "animations", []); count(anim_missing(a)) == 0]

deny contains msg if {
	count(object.get(input, "screens", [])) == 0
	msg := "S0: no stills are planned"
}

deny contains x.msg if some x in case_deny

# METADATA
# title: "S7 — a fact the measurement did not state is withheld, not judged"
withheld contains msg if {
	some s in object.get(input, "screens", [])
	some f in still_missing(s)
	msg := sprintf("S7: %v: %s was not measured", [object.get(s, "file", null), f])
}

withheld contains msg if {
	some a in object.get(input, "animations", [])
	some f in anim_missing(a)
	msg := sprintf("S7: %v: %s was not measured", [object.get(a, "file", null), f])
}

withheld contains "S7: animations was not measured" if {
	object.get(input, "animations", null) == null
}

# the stills and animations judged and passed
admitted contains s.file if {
	some s in array.concat(stills, anims)
	not denied_file(s.file)
	not s8_unjudged(s.file)
	not s9_unjudged(s.file)
}

denied_file(f) if {
	some x in case_deny
	x.file == f
}

# METADATA
# title: "S1 — every planned still exists"
# description: |
#   The pictures are checked in and regenerated by one script; an emitter change
#   without a regeneration, or a render that produced no file, fails here.
case_deny contains {"file": s.file, "msg": sprintf("S1: %s is missing", [s.file])} if {
	some s in stills
	s.exists == false
}

# METADATA
# title: "S2 — a still is not blank"
# description: |
#   A render that drew nothing is one colour. The clock alone on its ground still
#   has lit, ghost and ground; a picture with fewer than three distinct colours
#   drew no surface.
case_deny contains {"file": s.file, "msg": sprintf("S2: %s has %d distinct colour(s) — nothing was drawn", [s.file, s.distinct])} if {
	some s in stills
	s.exists == true
	s.distinct < 3
}

# METADATA
# title: "S3 — a still sits on its variant's ground"
# description: |
#   The modal colour of a still is the variant's Window background (the harness's
#   window, where the clock and switcher sit) or its View background (what a
#   bound wallpaper or marquee draws as its own void). Anything else means the
#   picture was rendered under the wrong scheme.
case_deny contains {"file": s.file, "msg": sprintf("S3: %s has modal colour %s, not one of %v (variant %s)", [s.file, s.modal, s.grounds, s.variant])} if {
	some s in stills
	s.exists == true
	not s.modal in s.grounds
}

# METADATA
# title: "S4 — every planned animation exists with enough frames to move"
# description: |
#   The marquee animation is the harness's frames while the text is on the move;
#   fewer than ten is a still with a loop flag, not motion.
case_deny contains {"file": a.file, "msg": sprintf("S4: %s is missing", [a.file])} if {
	some a in anims
	a.exists == false
}

case_deny contains {"file": a.file, "msg": sprintf("S4: %s has %d frame(s) — not an animation", [a.file, a.frames])} if {
	some a in anims
	a.exists == true
	a.frames < 10
}

# METADATA
# title: "S5 — an animation never tears"
# description: |
#   A scroll is a left shift: each frame is the previous one moved left by at
#   most a quarter of the board, new content entering at the right. The
#   measurement finds the best shift per adjacent pair and the lit columns that
#   still disagree under it; a pair that disagrees beyond tolerance is a tear —
#   a rebuilt Row mid-scroll, a restart, frames out of order. The ring's wrap is
#   a left shift and passes.
case_deny contains {"file": a.file, "msg": sprintf("S5: %s tears at frame(s) %v", [a.file, [t.frame | some t in a.tears]])} if {
	some a in anims
	a.exists == true
	not logged(a)
	count(a.tears) > 0
}

# METADATA
# title: "S5 (logged) — where the harness logged its own offsets, a tear is a step off the run's constant step"
# description: |
#   W209 (2026-10-02). check_marquee_live writes the board x per grabbed frame into the APNG
#   (W208), so for those animations S5 judges WHAT THE HARNESS DID, not a linear-blend fit of
#   what it drew - the fit mis-reads the coverage-graded aperture field (W207) and reported
#   tears on a run the log shows as 60 steps of exactly +2.75 pip. The widget scrolls at one
#   speed, so every logged step equals the first; a restart, a frame out of order or a rebuilt
#   board is a step that differs. No tolerance: there is no fit to absorb. The image fit stays
#   for an animation with no log (logged_steps null).
logged(a) if is_array(object.get(a, "logged_steps", null))

step_tears(a) := [f | some i, s in a.logged_steps; abs(s - a.logged_steps[0]) > 0.000001; f := i + 2]

case_deny contains {"file": a.file, "msg": sprintf("S5: %s tears at frame(s) %v - logged step off the run's %v pip", [a.file, step_tears(a), a.logged_steps[0]])} if {
	some a in anims
	a.exists == true
	logged(a)
	count(a.logged_steps) > 0
	count(step_tears(a)) > 0
}

# METADATA
# title: "S8 — a scroll moves the content, then samples it (temporal subpixel)"
# description: |
#   W60 (operator, 2026-09-22, seeing pinholes-anim: "the pixelation of the glyphs is
#   calculated, and then the pixelated glyphs are moved ... we want the glyphs to move
#   and the pixelation RECALCULATED"). A pre-pixelated bitmap translated across the
#   field only ever moves by whole pips; a scroll that samples the moving content lands
#   between pips. W201 (2026-10-13): a run is refused when under 2/3 of its MOVING
#   steps are fractional (whole = within 0.001 of an integer), and the old rule (deny
#   only when EVERY step was whole) let one fractional step carry a pixelated run.
#
#   WHERE THE STEPS COME FROM. The harness's logged offsets (W208) where it wrote them,
#   exact; else the image fit render_screens.animation_facts measures (a whole k plus a
#   quarter-pip fraction per adjacent pair), which mis-reads the coverage-graded field
#   (W207: on the marquee it reads 24 to 26 of 35 fractional steps where the log reads
#   35 of 35). A STALL (a zero step) is not a move and is excluded from the share; a run
#   with no step at all, or only stalls, is withheld, not judged and not admitted.
s8_steps(a) := a.logged_steps if logged(a)
else := a.shifts if is_array(object.get(a, "shifts", null))
else := []

s8_moving(a) := [s | some s in s8_steps(a); abs(s) > 0.001]

s8_fractional(a) := [s | some s in s8_moving(a); abs(s - round(s)) > 0.001]

case_deny contains {"file": a.file, "msg": sprintf("S8: %s: only %d of %d moving step(s) are fractional, under 2/3 — pixelated, then moved", [a.file, count(s8_fractional(a)), count(s8_moving(a))])} if {
	some a in anims
	a.exists == true
	count(s8_moving(a)) > 0
	3 * count(s8_fractional(a)) < 2 * count(s8_moving(a))
}

withheld contains msg if {
	some a in anims
	a.exists == true
	count(s8_steps(a)) == 0
	msg := sprintf("S8: %s: no step was measured (no logged offsets, no image-fit shift)", [a.file])
}

withheld contains msg if {
	some a in anims
	a.exists == true
	count(s8_steps(a)) > 0
	count(s8_moving(a)) == 0
	msg := sprintf("S8: %s: every step is a stall, so there is nothing to judge", [a.file])
}

# an animation S8 could not judge is not admitted: "judged and passed" must mean every rule ran
s8_unjudged(f) if {
	some a in anims
	a.file == f
	a.exists == true
	count(s8_moving(a)) == 0
}

# METADATA
# title: "S9 — a scroll does not see-saw between whole and half pips"
# description: |
#   W202. A scroll that alternates between a whole-pip state and a half-pip state, frame
#   after frame, looks like a flicker however fast it moves, and S8's step share cannot
#   see it (its steps are still fractional). Per pip, brightness over the run is a time
#   series; render_screens.spectral_lines sums its spectrum over the pips and reports the
#   share of the non-DC power at period 2 frames, the highest bin.
#
#   THE THRESHOLD, STATED: 0.25. A broadband run spreads its power over about N/2 bins,
#   so one bin holds about 2/N of it (about 0.05 for the marquee's 37 frames); the real
#   animations read 0.039 to 0.040 (marquee) and 0.013 (pinholes), the synthetic steady
#   scroll 0.031, and the synthetic see-saw (whole, half, whole, half) 0.937
#   (check_screens --selftest). 0.25 is five times the noise level and under a third of
#   the see-saw; it is the project's judgement, not a standard's. A run with no spectrum
#   (under 4 frames, or nothing moves) is withheld, not judged and not admitted.
s9_max := 0.25

case_deny contains {"file": a.file, "msg": sprintf("S9: %s: %v of the run's temporal power sits at period 2 (over %v) — a see-saw between whole and half pips", [a.file, a.period2_share, s9_max])} if {
	some a in anims
	a.exists == true
	is_number(object.get(a, "period2_share", null))
	a.period2_share > s9_max
}

withheld contains msg if {
	some a in anims
	a.exists == true
	not is_number(object.get(a, "period2_share", null))
	msg := sprintf("S9: %s: no period-2 share was measured (under 4 frames, or nothing moves)", [a.file])
}

s9_unjudged(f) if {
	some a in anims
	a.file == f
	a.exists == true
	not is_number(object.get(a, "period2_share", null))
}

# METADATA
# title: "S6 — an animation loops seamlessly"
# description: |
#   One item's whole run: the first and last frames are the same picture (the
#   empty board), so the loop closes without a jump (operator: "doesn't qualify
#   for r/perfectloops").
case_deny contains {"file": a.file, "msg": sprintf("S6: %s does not loop — its first and last frames differ", [a.file])} if {
	some a in anims
	a.exists == true
	a.seamless == false
}
