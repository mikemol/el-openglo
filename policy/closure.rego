# METADATA
# title: "L0 — no stage measured admits nothing"
# description: |
#   The measurement is `scripts/check_closure.py --json`: every selftest stage's script, whether
#   closures.bzl (generated by `check_closure.py --write` from strace of gate/stage.sh) carries a
#   closure for it, whether the closure lists the script itself, and which listed files are not
#   tracked; plus closure keys no stage uses. This decides the SHAPE of the declaration. Whether a
#   closure is COMPLETE is not decided here: observation under-approximates (W458/W494's witness
#   runs the stage with only its closure present).
package el.closure

import rego.v1

# an ABSENT population is empty too
deny contains msg if {
	count(object.get(input, "cases", [])) == 0
	msg := "L0: no stage was measured; the population is empty, not every stage faithfully declared"
}

# METADATA
# title: "L1 — a stage with no closure"
deny contains msg if {
	some c in object.get(input, "cases", [])
	c.has_closure == false
	msg := sprintf("L1: %s has no closure in closures.bzl; run scripts/check_closure.py --write", [c.script])
}

# METADATA
# title: "L2 — a closure that does not list its own script"
deny contains msg if {
	some c in object.get(input, "cases", [])
	c.has_closure == true
	c.self_listed == false
	msg := sprintf("L2: the closure of %s does not list %s itself", [c.script, c.script])
}

# METADATA
# title: "L3 — a closure that lists an untracked file"
deny contains msg if {
	some c in object.get(input, "cases", [])
	some f in c.untracked
	msg := sprintf("L3: the closure of %s lists %s, which is not tracked (a stage's inputs are tracked files)", [c.script, f])
}

# METADATA
# title: "L4 — a closure for a stage that no longer exists"
deny contains msg if {
	some s in object.get(input, "stale", [])
	msg := sprintf("L4: closures.bzl carries a closure for %s, which is no stage; regenerate", [s])
}

admitted contains c.script if {
	some c in object.get(input, "cases", [])
	c.has_closure == true
	c.self_listed == true
	count(c.untracked) == 0
}
