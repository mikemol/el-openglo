# METADATA
# title: "L0 — no stage measured admits nothing"
# description: |
#   The measurement is `scripts/check_closure.py --json`: every selftest stage's script, whether
#   closures.bzl (generated by `check_closure.py --write` from strace of gate/stage.sh) carries a
#   closure for it, whether the closure lists the script itself, and which listed files are not
#   tracked; plus closure keys no stage uses. This decides the SHAPE of the declaration. Whether a
#   closure is COMPLETE is not decided here: observation under-approximates (W458/W494's witness
#   runs the stage with only its closure present).
# custom:
#   family: gate
package el.closure

import rego.v1

# an ABSENT population is empty too
deny contains msg if {
	count(object.get(input, "cases", [])) == 0
	msg := "L0: no stage was measured; the population is empty, not every stage faithfully declared"
}

# METADATA
# title: "L1 — a stage with no closure"
deny contains msg if {
	some c in object.get(input, "cases", [])
	c.has_closure == false
	msg := sprintf("L1: %s has no closure in closures.bzl; run scripts/check_closure.py --write", [c.script])
}

# METADATA
# title: "L2 — a closure that does not list its own script"
deny contains msg if {
	some c in object.get(input, "cases", [])
	c.has_closure == true
	c.self_listed == false
	msg := sprintf("L2: the closure of %s does not list %s itself", [c.script, c.script])
}

# METADATA
# title: "L3 — a closure that lists an untracked file"
deny contains msg if {
	some c in object.get(input, "cases", [])
	some f in c.untracked
	msg := sprintf("L3: the closure of %s lists %s, which is not tracked (a stage's inputs are tracked files)", [c.script, f])
}

# METADATA
# title: "L4 — a closure for a stage that no longer exists"
deny contains msg if {
	some s in object.get(input, "stale", [])
	msg := sprintf("L4: closures.bzl carries a closure for %s, which is no stage; regenerate", [s])
}

# METADATA
# title: "L5 — a closure that is not sufficient (the witness's arm 1)"
# description: |
#   Only present when the gate stage ran the witness (CLOSURE_WITNESS=1): the stage was run in a temp
#   tree holding ONLY its closure, and it did not pass, so the closure omits something it reads.
deny contains msg if {
	some w in object.get(input, "witness", [])
	w.arm1 == "fail"
	msg := sprintf("L5: %s fails in a tree holding only its closure, so the closure is incomplete: %s", [w.script, w.detail])
}

# METADATA
# title: "L6 — a closure node that loads a node that is not there"
# description: |
#   W662: the closure declaration is a tree of closures_*.bzl nodes (closures.bzl is the root). A load of a
#   node file that does not exist is a declaration Bazel cannot analyse and the reader cannot follow.
#   `tree` is absent in a fixture and then says nothing.
deny contains msg if {
	some d in object.get(object.get(input, "tree", {}), "dangling", [])
	msg := sprintf("L6: %s: the loaded node file is absent; regenerate (check_closure.py --write)", [d])
}

# METADATA
# title: "L7 — a closure node nothing loads"
# description: |
#   A node file no other node (and not the root) loads is stale: a spec or family that went away and left its
#   leaf behind, which the tree would keep reading as part of no closure.
deny contains msg if {
	some o in object.get(object.get(input, "tree", {}), "orphans", [])
	msg := sprintf("L7: closures_%s.bzl is a closure node nothing loads; git rm it or regenerate (check_closure.py --write)", [o])
}

# METADATA
# title: "L8 — a listed directory with no tracked file"
# description: |
#   W693: closures_dirs.bzl records the directories each stage LISTED. A listed directory that holds no
#   tracked file directly inside it names something a checkout does not carry, so the record cannot be
#   reproduced from the repo. `empty_dirs` is absent in a fixture and then says nothing.
deny contains msg if {
	some d in object.get(object.get(input, "tree", {}), "empty_dirs", [])
	msg := sprintf("L8: %s: the listed directory holds no tracked file; regenerate (check_closure.py --write)", [d])
}

# METADATA
# title: "W — a witness that could not judge"
# description: |
#   NOT CONFIRMED IS NOT FAILED: a stage that needs a git work tree is exempt from arm 1 (WITH its
#   reason), and one whose imported modules all survived a planted defect is unproven on arm 2 (an
#   import may sit on a path the selftest never takes). Counted and printed, never admitted or denied.
withheld contains msg if {
	some w in object.get(input, "witness", [])
	w.arm1 == "exempt"
	msg := sprintf("W: %s is exempt from the sufficiency witness: %s", [w.script, w.detail])
}

withheld contains msg if {
	some w in object.get(input, "witness", [])
	w.arm1 == "known"
	msg := sprintf("W: %s passes its witness except the claims %s", [w.script, w.detail])
}

withheld contains msg if {
	some w in object.get(input, "witness", [])
	w.arm2 == "unproven"
	msg := sprintf("W: %s: no import of it carried a planted defect to the verdict (unproven, not failed)", [w.script])
}

admitted contains c.script if {
	some c in object.get(input, "cases", [])
	c.has_closure == true
	c.self_listed == true
	count(c.untracked) == 0
}
