{
  "env": {
    "STRUCT_HOOK_BLOCK": "1",
    "NOCHAIN_HOOK_BLOCK": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "STRUCT_HOOK_BLOCK=1 python3 \"$CLAUDE_PROJECT_DIR/scripts/hook_structural_query.py\""
          },
          {
            "type": "command",
            "command": "NOCHAIN_HOOK_BLOCK=1 python3 \"$CLAUDE_PROJECT_DIR/scripts/hook_no_chaining.py\""
          }
        ]
      }
    ]
  }
}
